def dp(value):
    return int(AndroidUtilities.dp(value))


def color(names, fallback):
    if isinstance(names, str):
        names = [names]
    for name in names:
        try:
            return int(Theme.getColor(getattr(Theme, name)))
        except Exception:
            pass
    return int(Color.parseColor(fallback))


def alpha(value, a):
    return int(Color.argb(a, Color.red(value), Color.green(value), Color.blue(value)))


def rounded(value, radius):
    shape = GradientDrawable()
    shape.setColor(value)
    shape.setCornerRadius(float(dp(radius)))
    return shape


def ripple(kind=2):
    try:
        return Theme.createSelectorDrawable(color("key_listSelector", "#1F000000"), kind)
    except Exception:
        return None


def drawable_id(ctx, names):
    for name in names:
        try:
            found = int(ctx.getResources().getIdentifier(name, "drawable", ctx.getPackageName()))
            if found:
                return found
        except Exception:
            pass
    return 0


def make_icon(ctx, names, tint, fallback):
    found = drawable_id(ctx, names)
    if found:
        view = ImageView(ctx)
        view.setScaleType(ImageView.ScaleType.CENTER)
        view.setImageDrawable(ctx.getResources().getDrawable(found).mutate())
        view.setColorFilter(PorterDuffColorFilter(tint, PorterDuff.Mode.SRC_IN))
        return view
    view = TextView(ctx)
    view.setText(fallback)
    view.setTextColor(tint)
    view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 22)
    view.setGravity(Gravity.CENTER)
    return view


def mix(first, second, amount):
    result = 0xFF
    for shift in (16, 8, 0):
        one = (first >> shift) & 255
        two = (second >> shift) & 255
        result = (result << 8) | int(one * (1 - amount) + two * amount)
    return result - (1 << 32) if result >= (1 << 31) else result


def brightness(value):
    value = int(value) & 0xFFFFFFFF
    return (0.299 * ((value >> 16) & 255) + 0.587 * ((value >> 8) & 255) + 0.114 * (value & 255)) / 255.0


def light_color(names, fallback, minimum=0.2):
    """Первый цвет темы, который не выглядит чёрным; иначе запасной."""
    if isinstance(names, str):
        names = [names]
    for name in names:
        try:
            found = int(Theme.getColor(getattr(Theme, name)))
            if brightness(found) >= minimum:
                return found
        except Exception:
            pass
    return int(Color.parseColor(fallback))


def accent_color():
    return light_color(["key_dialogTextBlue", "key_chat_messagePanelSend", "key_windowBackgroundWhiteBlueText"], "#3390EC")


def icon_color():
    return accent_color()


def field_text():
    return mix(accent_color(), Color.parseColor("#000000"), 0.3)


def field_background(radius):
    accent = accent_color()
    shape = rounded(Color.parseColor("#FFFFFF"), radius)
    try:
        shape.setStroke(dp(1), alpha(accent, 220))
    except Exception:
        pass
    return shape


def style_field(field):
    accent = accent_color()
    field.setTextColor(field_text())
    field.setHintTextColor(Color.parseColor("#8E9AA8"))
    field.setBackground(field_background(12))
    try:
        field.setHighlightColor(alpha(accent, 90))
    except Exception:
        pass
    try:
        cursor = GradientDrawable()
        cursor.setColor(accent)
        cursor.setSize(dp(2), dp(20))
        field.setTextCursorDrawable(cursor)
    except Exception:
        pass


def recolor_lottie(node, rgb):
    """Заменяет цвета заливок и обводок в Lottie-данных на rgb (0..1)."""
    if isinstance(node, dict):
        value = node.get("c")
        if isinstance(value, dict) and "k" in value:
            keys = value["k"]
            if value.get("a") == 0 and isinstance(keys, list) and len(keys) >= 3:
                value["k"] = [rgb[0], rgb[1], rgb[2]] + list(keys[3:])
            elif value.get("a") == 1 and isinstance(keys, list):
                for frame in keys:
                    for field in ("s", "e"):
                        if isinstance(frame, dict) and isinstance(frame.get(field), list) and len(frame[field]) >= 3:
                            frame[field] = [rgb[0], rgb[1], rgb[2]] + list(frame[field][3:])
        for child in node.values():
            recolor_lottie(child, rgb)
    elif isinstance(node, list):
        for child in node:
            recolor_lottie(child, rgb)


def icon_file(ctx, name, tint=None):
    # исходные .tgs белые: перекрашиваем в нужный цвет, чтобы значок был виден на любом фоне
    rgb = int(tint if tint is not None else icon_color()) & 0xFFFFFF
    key = "%s_%06x" % (name, rgb)
    path = ICON_FILES.get(key)
    if path and os.path.isfile(path):
        return path
    directory = os.path.join(str(ctx.getFilesDir().getAbsolutePath()), "workpieces_up", "icons")
    os.makedirs(directory, exist_ok=True)
    path = os.path.join(directory, key + ".tgs")
    if not os.path.isfile(path) or os.path.getsize(path) < 50:
        data = json.loads(gzip.decompress(base64.b64decode(ICON_DATA[name])).decode("utf-8"))
        recolor_lottie(data, [((rgb >> 16) & 255) / 255.0, ((rgb >> 8) & 255) / 255.0, (rgb & 255) / 255.0])
        packed = gzip.compress(json.dumps(data, separators=(",", ":")).encode("utf-8"), 9)
        temp = path + ".tmp"
        with open(temp, "wb") as handle:
            handle.write(packed)
        os.replace(temp, path)
    ICON_FILES[key] = path
    return path


LOTTIE_ERRORS = []
LOTTIE_REPORTED = []


def frames_ok(drawable):
    try:
        return int(drawable.getFramesCount()) > 0
    except Exception:
        return True


LOTTIE_INFO = []


def lottie_args(types, path, pixels):
    from java.io import File

    has_file = any(str(t.getName()) == "java.io.File" for t in types)
    booleans = [i for i, t in enumerate(types) if str(t.getName()) == "boolean"]
    ints = 0
    strings = 0
    args = []
    for index, t in enumerate(types):
        name = str(t.getName())
        if name == "java.io.File":
            args.append(File(path))
        elif name == "java.lang.String":
            if has_file:
                args.append(None)
            elif strings == 0:
                with open(path, "rb") as handle:
                    args.append(gzip.decompress(handle.read()).decode("utf-8"))
            else:
                args.append(os.path.basename(path))
            strings += 1
        elif name == "int":
            args.append(jint(pixels if ints < 2 else 0))
            ints += 1
        elif name == "long":
            args.append(0)
        elif name == "boolean":
            # последний boolean — запуск декодирования, остальные (limitFps, precache) выключены
            args.append(bool(len(booleans) > 1 and index == booleans[-1]))
        else:
            args.append(None)
    return args


def find_lottie_class(ctx, name="org.telegram.ui.Components.RLottieDrawable"):
    getters = [
        lambda: find_class(name),
        lambda: ctx.getClass().getClassLoader().loadClass(name),
        lambda: __import__("java").jclass("java.lang.Class").forName(name),
        lambda: AndroidUtilities.getClass().getClassLoader().loadClass(name),
    ]
    for getter in getters:
        try:
            found = getter()
            if found is not None and hasattr(found, "getDeclaredConstructors"):
                return found
        except Exception as error:
            LOTTIE_ERRORS.append("class: %s %s" % (type(error).__name__, error))
    return None


def direct_attempts(path, pixels):
    from java.io import File
    from org.telegram.ui.Components import RLottieDrawable

    return [
        lambda: RLottieDrawable(File(path), None, pixels, pixels, None, False, None, 0, True),
    ]


def make_lottie_drawable(path, pixels, ctx=None):
    lottie_class = find_lottie_class(ctx)
    if lottie_class is None:
        for attempt in direct_attempts(path, pixels):
            try:
                drawable = attempt()
                if frames_ok(drawable):
                    return drawable
            except Exception as error:
                LOTTIE_ERRORS.append("%s %s" % (type(error).__name__, error))
        raise RuntimeError("нет подходящего конструктора")
    constructors = list(lottie_class.getDeclaredConstructors())
    if not LOTTIE_INFO:
        for ctor in constructors:
            LOTTIE_INFO.append(", ".join(str(t.getSimpleName()) for t in ctor.getParameterTypes()))

    def usable(ctor):
        names = [str(t.getName()) for t in ctor.getParameterTypes()]
        if "java.io.File" in names:
            return 0
        if "java.lang.String" in names and names.count("int") >= 2:
            return 1
        return 2

    last = None
    for ctor in sorted(constructors, key=usable):
        if usable(ctor) > 1:
            continue
        try:
            ctor.setAccessible(True)
            drawable = ctor.newInstance(*lottie_args(ctor.getParameterTypes(), path, pixels))
            if frames_ok(drawable):
                return drawable
            LOTTIE_ERRORS.append("0 кадров")
        except Exception as error:
            last = error
            LOTTIE_ERRORS.append("%s %s" % (type(error).__name__, error))
    raise last or RuntimeError("нет подходящего конструктора")


def show_lottie_report():
    try:
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment is not None else None
        dialog = AlertDialogBuilder(activity)
        dialog.set_title("Анимация не загрузилась")
        dialog.set_message("Конструкторы RLottieDrawable:\n%s\n\nОшибки:\n%s" % ("\n".join(LOTTIE_INFO) or "нет", "\n".join(e[:220] for e in LOTTIE_ERRORS[-6:])))
        dialog.set_positive_button("OK", lambda builder, which: builder.dismiss())
        dialog.show()
    except Exception:
        BulletinHelper.show_error(("Анимация: %s" % "; ".join(LOTTIE_ERRORS[-2:]))[:200])


def lottie_icon(ctx, name, size, fallback, loop=False, tint=None):
    try:
        pixels = dp(size)
        if tint is None:
            tint = icon_color()
        drawable = make_lottie_drawable(icon_file(ctx, name, tint), pixels, ctx)
        view = ImageView(ctx)
        view.setScaleType(ImageView.ScaleType.FIT_CENTER)
        view.setImageDrawable(drawable)
        for call in (lambda: drawable.setAllowDecodeSingleFrame(True),
                     lambda: drawable.setCurrentParentView(view),
                     lambda: drawable.setAutoRepeat(1 if loop else 0),
                     lambda: drawable.start()):
            try:
                call()
            except Exception as error:
                LOTTIE_ERRORS.append("%s %s" % (type(error).__name__, error))
        try:
            from java import dynamic_proxy

            class Attach(dynamic_proxy(View.OnAttachStateChangeListener)):
                def onViewAttachedToWindow(self, v):
                    try:
                        drawable.setCurrentParentView(v)
                        drawable.start()
                    except Exception:
                        pass

                def onViewDetachedFromWindow(self, v):
                    pass

            view.addOnAttachStateChangeListener(Attach())
        except Exception as error:
            LOTTIE_ERRORS.append("attach: %s %s" % (type(error).__name__, error))
        return view
    except Exception as error:
        LOTTIE_ERRORS.append("итог: %s %s" % (type(error).__name__, error))
        if not LOTTIE_REPORTED:
            LOTTIE_REPORTED.append(True)
            show_lottie_report()
        view = TextView(ctx)
        view.setText(fallback)
        view.setTextColor(tint if tint is not None else icon_color())
        view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, size * 0.7)
        view.setGravity(Gravity.CENTER)
        return view


def replay(view):
    try:
        drawable = view.getDrawable()
        drawable.setCurrentFrame(0)
        drawable.start()
    except Exception:
        pass


THUMBS = {}
MEDIA_NAMES = {"photo": "фото", "video": "видео", "audio": "аудио", "document": "файл"}


def media_bitmap(entry, size):
    """Квадратная миниатюра с закруглёнными углами для фото и видео."""
    path = entry.get("path", "")
    px = dp(size)
    key = (path, px)
    if key in THUMBS:
        return THUMBS[key]
    result = None
    try:
        source = None
        if entry.get("type") == "photo":
            bounds = BitmapFactory.Options()
            bounds.inJustDecodeBounds = True
            BitmapFactory.decodeFile(path, bounds)
            width = int(bounds.outWidth)
            height = int(bounds.outHeight)
            sample = 1
            while width // (sample * 2) >= px and height // (sample * 2) >= px:
                sample *= 2
            options = BitmapFactory.Options()
            options.inSampleSize = sample
            source = BitmapFactory.decodeFile(path, options)
        elif entry.get("type") == "video":
            source = ThumbnailUtils.createVideoThumbnail(path, 1)
        if source is not None:
            square = ThumbnailUtils.extractThumbnail(source, px, px)
            output = Bitmap.createBitmap(px, px, Bitmap.Config.ARGB_8888)
            paint = Paint(Paint.ANTI_ALIAS_FLAG)
            paint.setShader(BitmapShader(square, Shader.TileMode.CLAMP, Shader.TileMode.CLAMP))
            radius = float(dp(8))
            Canvas(output).drawRoundRect(RectF(0.0, 0.0, float(px), float(px)), radius, radius, paint)
            result = output
    except Exception:
        result = None
    THUMBS[key] = result
    return result


def thumb_view(ctx, entry, size, on_remove=None, show_name=False):
    frame = FrameLayout(ctx)
    accent = accent_color()
    kind = entry.get("type")
    bitmap = media_bitmap(entry, size) if kind in ("photo", "video") else None
    if bitmap is not None:
        picture = ImageView(ctx)
        picture.setScaleType(ImageView.ScaleType.CENTER_CROP)
        picture.setImageBitmap(bitmap)
        frame.addView(picture, FrameLayout.LayoutParams(dp(size), dp(size)))
        if kind == "video":
            play = TextView(ctx)
            play.setText("▶")
            play.setTextColor(Color.WHITE)
            play.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 10)
            play.setGravity(Gravity.CENTER)
            play.setBackground(rounded(alpha(Color.BLACK, 130), 11))
            frame.addView(play, FrameLayout.LayoutParams(dp(22), dp(22), Gravity.CENTER))
    else:
        tile = LinearLayout(ctx)
        tile.setOrientation(LinearLayout.VERTICAL)
        tile.setGravity(Gravity.CENTER)
        tile.setBackground(rounded(alpha(accent, 36), 8))
        tile.setPadding(dp(3), dp(3), dp(3), dp(3))
        icon = TextView(ctx)
        icon.setText(MEDIA_ICONS.get(kind, "📎"))
        icon.setTextSize(TypedValue.COMPLEX_UNIT_DIP, size * 0.4 if not show_name else 22)
        icon.setGravity(Gravity.CENTER)
        tile.addView(icon, LinearLayout.LayoutParams(WRAP, WRAP))
        if show_name:
            name = TextView(ctx)
            name.setText(entry.get("name", "файл"))
            name.setTextColor(field_text())
            name.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 9)
            name.setGravity(Gravity.CENTER)
            name.setMaxLines(2)
            name.setEllipsize(TextUtils.TruncateAt.END)
            tile.addView(name, LinearLayout.LayoutParams(MATCH, WRAP))
        frame.addView(tile, FrameLayout.LayoutParams(dp(size), dp(size)))
    if on_remove is not None:
        badge = FrameLayout(ctx)
        badge.setBackground(rounded(alpha(Color.BLACK, 150), 11))
        badge.setPadding(dp(4), dp(4), dp(4), dp(4))
        trash = lottie_icon(ctx, "003", 14, "✕", tint=Color.WHITE)
        badge.addView(trash, FrameLayout.LayoutParams(dp(14), dp(14)))
        badge.setOnClickListener(OnClickListener(lambda v: on_remove()))
        params = FrameLayout.LayoutParams(dp(22), dp(22), Gravity.TOP | Gravity.END)
        params.setMargins(0, dp(3), dp(3), 0)
        frame.addView(badge, params)
    return frame


def media_summary(media):
    counts = {}
    for entry in media:
        counts[entry.get("type")] = counts.get(entry.get("type"), 0) + 1
    parts = ["%d %s" % (n, MEDIA_NAMES.get(k, "файл")) for k, n in counts.items()]
    return ", ".join(parts)


def show_actions(ctx, rows):
    try:
        build_actions(ctx, rows)
    except Exception as error:
        BulletinHelper.show_error(("Меню: %s %s" % (type(error).__name__, error))[:160])
        menu = AlertDialogBuilder(ctx)

        def picked(builder, index):
            builder.dismiss()
            rows[int(index)][3]()

        menu.set_items([row[0] for row in rows], picked)
        menu.show()


def build_actions(ctx, rows):
    box = LinearLayout(ctx)
    box.setOrientation(LinearLayout.VERTICAL)
    box.setPadding(0, dp(6), 0, dp(6))

    dialog = AlertDialogBuilder(ctx)
    normal = color("key_dialogTextBlack", "#000000")
    red = color(["key_dialogTextRed", "key_text_RedBold", "key_dialogRedIcon"], "#E53935")

    for label, icon, emoji, callback, danger in rows:
        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        row.setPadding(dp(20), dp(10), dp(20), dp(10))
        background = ripple(2)
        if background is not None:
            row.setBackground(background)

        if icon:
            image = lottie_icon(ctx, icon, 28, emoji, tint=red if danger else icon_color())
        else:
            image = TextView(ctx)
            image.setText(emoji)
            image.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20)
            image.setGravity(Gravity.CENTER)
        row.addView(image, LinearLayout.LayoutParams(dp(28), dp(28)))

        text = TextView(ctx)
        text.setText(label)
        text.setTextColor(red if danger else normal)
        text.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16)
        params = LinearLayout.LayoutParams(0, WRAP, 1.0)
        params.leftMargin = dp(16)
        row.addView(text, params)

        def clicked(v, callback=callback):
            dialog.dismiss()
            callback()

        row.setOnClickListener(OnClickListener(clicked))
        box.addView(row, LinearLayout.LayoutParams(MATCH, WRAP))

    dialog.set_view(box, WRAP)
    dialog.show()


def ask(ctx, title, hint, initial, multiline, ok_text, on_ok, show_markdown=False):
    text_color = color("key_dialogTextBlack", "#000000")
    gray = color("key_dialogTextGray2", "#8A8A8A")

    field = EditText(ctx)
    field.setHint(hint)
    field.setText(initial)
    style_field(field)
    field.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16)
    field.setPadding(dp(14), dp(10), dp(14), dp(10))
    if multiline:
        field.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_MULTI_LINE | InputType.TYPE_TEXT_FLAG_CAP_SENTENCES)
        field.setMinLines(4)
        field.setMaxLines(10)
        field.setGravity(Gravity.TOP | Gravity.START)
    else:
        field.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_CAP_SENTENCES)
        field.setSingleLine(True)
    field.setSelection(field.getText().length())

    box = LinearLayout(ctx)
    box.setOrientation(LinearLayout.VERTICAL)
    box.setPadding(dp(20), dp(4), dp(20), 0)
    box.addView(field, LinearLayout.LayoutParams(MATCH, WRAP))

    if show_markdown:
        hint_view = TextView(ctx)
        hint_view.setText(MARKDOWN_HINT)
        hint_view.setTextColor(gray)
        hint_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
        params = LinearLayout.LayoutParams(MATCH, WRAP)
        params.topMargin = dp(8)
        box.addView(hint_view, params)

    dialog = AlertDialogBuilder(ctx)
    dialog.set_title(title)
    dialog.set_view(box, WRAP)

    def confirm(builder, which):
        value = str(field.getText().toString()).strip()
        builder.dismiss()
        if value:
            on_ok(value)

    dialog.set_positive_button(ok_text, confirm)
    dialog.set_negative_button("Отмена", lambda builder, which: builder.dismiss())
    dialog.show()

    def focus():
        field.requestFocus()
        AndroidUtilities.showKeyboard(field)

    run_on_ui_thread(focus, 150)


class TemplatesDialog:
    def __init__(self, plugin, ctx, target):
        self.plugin = plugin
        self.ctx = ctx
        self.target = target
        self.folder_id = None
        self.dialog = None
        self.title = None
        self.back = None
        self.list = None
        self.logo = None

    def show(self):
        ctx = self.ctx
        header_height = dp(56)
        list_height = max(dp(220), min(int(int(AndroidUtilities.displaySize.y) * 0.48), dp(420)))
        icon_tint = color("key_dialogIcon", "#8A8A8A")

        root = LinearLayout(ctx)
        root.setOrientation(LinearLayout.VERTICAL)

        header = LinearLayout(ctx)
        header.setOrientation(LinearLayout.HORIZONTAL)
        header.setGravity(Gravity.CENTER_VERTICAL)

        self.back = make_icon(ctx, ["ic_ab_back"], icon_tint, "←")
        self.back.setVisibility(View.GONE)
        self.back.setOnClickListener(OnClickListener(lambda v: self.open_folder(None)))
        header.addView(self.back, LinearLayout.LayoutParams(dp(48), dp(48)))

        self.logo = lottie_icon(ctx, "001", 30, "📋")
        logo_params = LinearLayout.LayoutParams(dp(30), dp(30))
        logo_params.leftMargin = dp(20)
        header.addView(self.logo, logo_params)

        self.title = TextView(ctx)
        self.title.setTextColor(color("key_dialogTextBlack", "#000000"))
        self.title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 19)
        self.title.setTypeface(Typeface.DEFAULT_BOLD)
        self.title.setSingleLine(True)
        self.title.setEllipsize(TextUtils.TruncateAt.END)
        header.addView(self.title, LinearLayout.LayoutParams(0, WRAP, 1.0))

        dots = make_icon(ctx, ["ic_ab_other"], icon_tint, "⋮")
        dots.setOnClickListener(OnClickListener(lambda v: self.show_menu()))
        header.addView(dots, LinearLayout.LayoutParams(dp(48), dp(48)))

        for button in (self.back, dots):
            background = ripple(1)
            if background is not None:
                button.setBackground(background)

        root.addView(header, LinearLayout.LayoutParams(MATCH, header_height))

        line = View(ctx)
        line.setBackgroundColor(color("key_divider", "#1F000000"))
        root.addView(line, LinearLayout.LayoutParams(MATCH, 1))

        scroll = ScrollView(ctx)
        scroll.setVerticalScrollBarEnabled(False)
        self.list = LinearLayout(ctx)
        self.list.setOrientation(LinearLayout.VERTICAL)
        scroll.addView(self.list, FrameLayout.LayoutParams(MATCH, WRAP))
        root.addView(scroll, LinearLayout.LayoutParams(MATCH, list_height))

        self.render()

        self.dialog = AlertDialogBuilder(ctx)
        self.dialog.set_view(root, header_height + 1 + list_height)
        self.dialog.show()

    def current_folder(self):
        for item in self.plugin.items:
            if item["id"] == self.folder_id and item["type"] == "folder":
                return item
        self.folder_id = None
        return None

    def current_items(self):
        folder = self.current_folder()
        return folder["items"] if folder else self.plugin.items

    def open_folder(self, folder_id):
        self.folder_id = folder_id
        self.render()

    def render(self):
        folder = self.current_folder()
        items = self.current_items()

        if folder:
            self.title.setText(folder["name"])
            self.title.setPadding(dp(4), 0, dp(8), 0)
            self.back.setVisibility(View.VISIBLE)
            self.logo.setVisibility(View.GONE)
        else:
            self.title.setText("Заготовки")
            self.title.setPadding(dp(12), 0, dp(8), 0)
            self.back.setVisibility(View.GONE)
            self.logo.setVisibility(View.VISIBLE)

        self.list.removeAllViews()

        if not items:
            self.list.addView(self.empty_view(), LinearLayout.LayoutParams(MATCH, WRAP))
            return

        for i, item in enumerate(items):
            row = self.folder_row(item) if item["type"] == "folder" else self.template_row(item)
            self.list.addView(row, LinearLayout.LayoutParams(MATCH, WRAP))
            if i < len(items) - 1:
                line = View(self.ctx)
                line.setBackgroundColor(alpha(color("key_divider", "#1F000000"), 90))
                params = LinearLayout.LayoutParams(MATCH, 1)
                params.leftMargin = dp(20)
                self.list.addView(line, params)

    def empty_view(self):
        box = LinearLayout(self.ctx)
        box.setOrientation(LinearLayout.VERTICAL)
        box.setGravity(Gravity.CENTER)
        box.setPadding(dp(32), dp(56), dp(32), dp(32))

        icon = lottie_icon(self.ctx, "001", 96, "📋", loop=True)
        box.addView(icon, LinearLayout.LayoutParams(dp(96), dp(96)))

        text = TextView(self.ctx)
        text.setText("Пока нет заготовок\nНажмите ⋮ сверху и выберите «Добавить заготовку»")
        text.setTextColor(color("key_dialogTextGray2", "#8A8A8A"))
        text.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
        text.setGravity(Gravity.CENTER)
        params = LinearLayout.LayoutParams(WRAP, WRAP)
        params.topMargin = dp(12)
        box.addView(text, params)
        return box

    def base_row(self):
        row = LinearLayout(self.ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        row.setPadding(dp(20), dp(13), dp(16), dp(13))
        background = ripple(2)
        if background is not None:
            row.setBackground(background)
        return row

    def template_row(self, item):
        row = self.base_row()
        media = self.plugin.item_media(item)
        text_value = item.get("text", "") or ""

        if media:
            thumbs = LinearLayout(self.ctx)
            thumbs.setOrientation(LinearLayout.HORIZONTAL)
            for entry in media[:3]:
                params = LinearLayout.LayoutParams(dp(46), dp(46))
                params.rightMargin = dp(6)
                thumbs.addView(thumb_view(self.ctx, entry, 46), params)
            if len(media) > 3:
                more = TextView(self.ctx)
                more.setText("+%d" % (len(media) - 3))
                more.setTextColor(field_text())
                more.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
                more.setGravity(Gravity.CENTER)
                more.setBackground(rounded(alpha(accent_color(), 36), 8))
                params = LinearLayout.LayoutParams(dp(46), dp(46))
                params.rightMargin = dp(6)
                thumbs.addView(more, params)
            row.addView(thumbs, LinearLayout.LayoutParams(WRAP, WRAP))

        text = TextView(self.ctx)
        if text_value:
            text.setText(text_value)
        elif media:
            names = [e.get("name", "") for e in media if e.get("type") in ("audio", "document")]
            text.setText(names[0] + (" (+%d)" % (len(media) - 1) if len(media) > 1 else "") if names else media_summary(media))
        text.setTextColor(color("key_dialogTextBlack", "#000000"))
        text.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16)
        text.setMaxLines(3)
        text.setEllipsize(TextUtils.TruncateAt.END)
        params = LinearLayout.LayoutParams(0, WRAP, 1.0)
        if media:
            params.leftMargin = dp(4)
        row.addView(text, params)

        row.setOnClickListener(OnClickListener(lambda v, item=item: self.send(item)))
        row.setOnLongClickListener(OnLongClickListener(lambda v, item=item: self.item_menu(item)))
        return row

    def folder_row(self, item):
        row = self.base_row()

        icon = TextView(self.ctx)
        icon.setText("📁")
        icon.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 22)
        row.addView(icon, LinearLayout.LayoutParams(WRAP, WRAP))

        name = TextView(self.ctx)
        name.setText(item["name"])
        name.setTextColor(color("key_dialogTextBlack", "#000000"))
        name.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16)
        name.setTypeface(Typeface.DEFAULT_BOLD)
        name.setSingleLine(True)
        name.setEllipsize(TextUtils.TruncateAt.END)
        params = LinearLayout.LayoutParams(0, WRAP, 1.0)
        params.leftMargin = dp(14)
        row.addView(name, params)

        count = TextView(self.ctx)
        count.setText(str(len(item["items"])))
        count.setTextColor(color("key_dialogTextGray2", "#8A8A8A"))
        count.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
        row.addView(count, LinearLayout.LayoutParams(WRAP, WRAP))

        row.setOnClickListener(OnClickListener(lambda v, item=item: self.open_folder(item["id"])))
        row.setOnLongClickListener(OnLongClickListener(lambda v, item=item: self.item_menu(item)))
        return row

    def send(self, item):
        self.dialog.dismiss()
        self.plugin.send_template(item, self.target)

    def show_menu(self):
        rows = [
            ("Добавить заготовку", "002", "➕", self.add_template, False),
            ("Инструкция", "004", "📖", lambda: self.plugin.show_markdown_help(self.ctx), False),
        ]
        if not self.folder_id:
            rows.append(("Создать папку", "folder", "📁", self.add_folder, False))
        show_actions(self.ctx, rows)

    def add_template(self):
        self.plugin.show_template_editor(self.ctx, self.folder_id, None, self.render)

    def add_folder(self):
        def save(name):
            self.plugin.add_folder(name)
            self.render()

        ask(self.ctx, "Новая папка", "Название папки", "", False, "Создать", save)

    def item_menu(self, item):
        is_folder = item["type"] == "folder"
        rows = [("Переименовать" if is_folder else "Редактировать", "edit", "✏️", lambda: self.edit(item), False)]
        if not is_folder and self.folder_id is None:
            rows.append(("Добавить в папку", "002", "📂", lambda: self.choose_folder_for_item(item), False))
        rows.append(("Удалить", "003", "🗑", lambda: self.remove(item), True))
        show_actions(self.ctx, rows)
        return True

    def choose_folder_for_item(self, item):
        folders = [x for x in self.plugin.items if x.get("type") == "folder"]
        if not folders:
            BulletinHelper.show_info("Сначала создайте папку")
            return
        labels = [folder.get("name", "Папка") for folder in folders]
        picker = AlertDialogBuilder(self.ctx)

        def picked(builder, index):
            builder.dismiss()
            if 0 <= int(index) < len(folders):
                self.plugin.move_template_to_folder(item, folders[int(index)])
                self.render()
                BulletinHelper.show_info("Заготовка добавлена в папку")

        picker.set_title("Добавить в папку")
        picker.set_items(labels, picked)
        picker.show()

    def edit(self, item):
        if item["type"] == "folder":
            def save_name(name):
                self.plugin.rename_folder(item, name)
                self.render()

            ask(self.ctx, "Переименовать папку", "Название папки", item["name"], False, "Сохранить", save_name)
        else:
            self.plugin.show_template_editor(self.ctx, self.folder_id, item, self.render)

    def remove(self, item):
        if item["type"] != "folder":
            self.plugin.delete_item(item["id"])
            self.render()
            return

        dialog = AlertDialogBuilder(self.ctx)
        dialog.set_title("Удалить папку?")
        dialog.set_message("Папка «%s» и все заготовки в ней (%d) будут удалены." % (item["name"], len(item["items"])))

        def confirm(builder, which):
            builder.dismiss()
            self.plugin.delete_item(item["id"])
            self.render()

        dialog.set_positive_button("Удалить", confirm)
        dialog.set_negative_button("Отмена", lambda builder, which: builder.dismiss())
        dialog.show()
        try:
            dialog.make_button_red(AlertDialogBuilder.BUTTON_POSITIVE)
        except Exception:
            pass


class ConstructorHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin.hook_field_right(param.thisObject.getClass())
        except Exception:
            self.plugin.logger.exception("cannot hook updateFieldRight")
        try:
            self.plugin.inject(param.thisObject)
        except Exception:
            self.plugin.logger.exception("constructor hook failed")


class FieldRightHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            if int(param.args[0]) == 1:
                self.plugin.fix_margin(param.thisObject)
        except Exception:
            self.plugin.logger.exception("updateFieldRight hook failed")


class ActivityResultHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            code = int(param.args[0])
            self.plugin.seen_codes.append(code)
            if code == PICKER_REQUEST_CODE:
                self.plugin.handle_picker_result(param.args[1], param.args[2])
        except Exception as error:
            self.plugin.logger.exception("picker result hook failed")
            BulletinHelper.show_error(("Ошибка результата: %s %s" % (type(error).__name__, error))[:160])


class WorkpiecesUpPlugin(BasePlugin):
    items = []

    def on_plugin_load(self):
        self.items = self.load_items()
        self.pending_picker = None
        self.editor = None
        self.hooked_result_classes = set()
        self.field_right_hooked = False
        self.hook_log = []
        self.seen_codes = []
        try:
            self.message_menu_id = self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                text="Добавить в заготовки",
                on_click=self.add_template_from_message,
                icon="msg_quickreply",
                priority=5,
            ))
        except Exception:
            self.logger.exception("cannot register message context menu")

        enter_view = find_class(ENTER_VIEW)
        if not enter_view:
            self.logger.error("ChatActivityEnterView not found")
            return

        self.hook_all_constructors(enter_view, ConstructorHook(self))

        run_on_ui_thread(self.inject_current_chat)

    def on_plugin_unload(self):
        run_on_ui_thread(self.remove_from_current_chat)

    def show_template_editor(self, ctx, folder_id, item, on_saved):
        text_color = color("key_dialogTextBlack", "#000000")
        gray = color("key_dialogTextGray2", "#8A8A8A")
        blue = accent_color()

        original = [dict(entry) for entry in self.item_media(item)]
        media = [dict(entry) for entry in original]
        self.editor = {"media": media}

        box = LinearLayout(ctx)
        box.setOrientation(LinearLayout.VERTICAL)
        box.setPadding(dp(20), dp(4), dp(20), 0)

        text_field = EditText(ctx)
        text_field.setHint("Текст заготовки")
        text_field.setText((item or {}).get("text", ""))
        style_field(text_field)
        text_field.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16)
        text_field.setPadding(dp(14), dp(10), dp(14), dp(10))
        text_field.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_MULTI_LINE | InputType.TYPE_TEXT_FLAG_CAP_SENTENCES)
        text_field.setMinLines(4)
        text_field.setMaxLines(9)
        text_field.setGravity(Gravity.TOP | Gravity.START)
        box.addView(text_field, LinearLayout.LayoutParams(MATCH, WRAP))

        attachments = HorizontalScrollView(ctx)
        attachments.setHorizontalScrollBarEnabled(False)
        strip = LinearLayout(ctx)
        strip.setOrientation(LinearLayout.HORIZONTAL)
        attachments.addView(strip, FrameLayout.LayoutParams(WRAP, WRAP))
        attach_params = LinearLayout.LayoutParams(MATCH, WRAP)
        attach_params.topMargin = dp(8)
        box.addView(attachments, attach_params)

        def refresh():
            strip.removeAllViews()
            attachments.setVisibility(View.VISIBLE if media else View.GONE)
            for entry in list(media):
                def drop(entry=entry):
                    if entry in media:
                        media.remove(entry)
                    refresh()

                params = LinearLayout.LayoutParams(dp(76), dp(76))
                params.rightMargin = dp(8)
                strip.addView(thumb_view(ctx, entry, 76, on_remove=drop, show_name=True), params)

        self.editor["refresh"] = refresh
        refresh()

        buttons = [("📎 Файл", "file"), ("🖼 Фото", "photo"), ("🎬 Видео", "video"), ("🎵 Аудио", "audio")]
        for start in (0, 2):
            line = LinearLayout(ctx)
            line.setOrientation(LinearLayout.HORIZONTAL)
            for label, kind in buttons[start:start + 2]:
                button = TextView(ctx)
                button.setText(label)
                button.setTextColor(blue)
                button.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
                button.setGravity(Gravity.CENTER)
                button.setPadding(dp(8), dp(10), dp(8), dp(10))
                button.setBackground(rounded(alpha(blue, 32), 10))
                button.setOnClickListener(OnClickListener(lambda v, kind=kind: self.open_file_picker(ctx, kind)))
                params = LinearLayout.LayoutParams(0, WRAP, 1.0)
                params.setMargins(dp(2), dp(6), dp(2), 0)
                line.addView(button, params)
            box.addView(line, LinearLayout.LayoutParams(MATCH, WRAP))

        hint = TextView(ctx)
        hint.setText("Поддерживается Markdown и HTML. Premium Emoji: <tg-emoji emoji-id='id'>символ</tg-emoji>. Нажмите ниже, чтобы открыть инструкцию.")
        hint.setTextColor(gray)
        hint.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
        params = LinearLayout.LayoutParams(MATCH, WRAP)
        params.topMargin = dp(10)
        box.addView(hint, params)

        markdown_help = LinearLayout(ctx)
        markdown_help.setOrientation(LinearLayout.HORIZONTAL)
        markdown_help.setGravity(Gravity.CENTER_VERTICAL)
        markdown_help.setPadding(0, dp(8), 0, dp(4))
        help_icon = lottie_icon(ctx, "004", 24, "📖", tint=blue)
        markdown_help.addView(help_icon, LinearLayout.LayoutParams(dp(24), dp(24)))
        markdown_label = TextView(ctx)
        markdown_label.setText("Открыть инструкцию по Markdown")
        markdown_label.setTextColor(blue)
        markdown_label.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
        label_margin = LinearLayout.LayoutParams(WRAP, WRAP)
        label_margin.leftMargin = dp(8)
        markdown_help.addView(markdown_label, label_margin)
        markdown_help.setOnClickListener(OnClickListener(lambda v: self.show_markdown_help(ctx)))
        box.addView(markdown_help, LinearLayout.LayoutParams(MATCH, WRAP))

        scroll = ScrollView(ctx)
        scroll.setVerticalScrollBarEnabled(False)
        scroll.addView(box, FrameLayout.LayoutParams(MATCH, WRAP))

        def discard():
            kept = set(entry["path"] for entry in original)
            self.drop_files([entry for entry in media if entry["path"] not in kept])

        dialog = AlertDialogBuilder(ctx)
        dialog.set_title("Редактировать заготовку" if item else "Новая заготовка")
        dialog.set_view(scroll, WRAP)

        def confirm(builder, which):
            value = str(text_field.getText().toString()).strip()
            builder.dismiss()
            self.editor = None
            if not value and not media:
                discard()
                return
            still_used = set(entry["path"] for entry in media)
            self.drop_files([entry for entry in original if entry["path"] not in still_used])
            if item:
                item["text"] = value
                item["media"] = media
                for key in ("media_path", "media_type", "media_mime", "media_name"):
                    item.pop(key, None)
                self.save_items()
            else:
                self.add_template(folder_id, value, media)
            on_saved()

        def cancel(builder, which):
            builder.dismiss()
            self.editor = None
            discard()

        dialog.set_positive_button("Сохранить" if item else "Добавить", confirm)
        dialog.set_negative_button("Отмена", cancel)
        dialog.show()

    def show_markdown_help(self, ctx):
        message = ("WORKPIECES UP — ИНСТРУКЦИЯ\n\n"
                   "ЗАГОТОВКИ\n"
                   "1. Нажмите на кнопку Workpieces Up возле поля ввода сообщения.\n"
                   "2. Нажмите ⋮ и выберите «Добавить заготовку».\n"
                   "3. Введите текст и при необходимости прикрепите файл.\n"
                   "4. Нажмите «Добавить». Чтобы отправить заготовку, выберите её в списке.\n"
                   "5. Удерживайте заготовку, чтобы открыть действия редактирования и удаления.\n\n"
                   "ВЛОЖЕНИЯ\n"
                   "В редакторе есть кнопки «Файл», «Фото», «Видео» и «Аудио». В системном окне можно отметить сразу несколько файлов, а кнопки можно нажимать повторно, чтобы добавить ещё. "
                   "Каждое вложение убирается крестиком. Фото отправляется как фото, видео как видео, аудио как аудио, «Файл» как документ без сжатия. "
                   "Если вложений несколько, они уходят по очереди, а текст заготовки становится подписью к первому. Файлы копируются в хранилище плагина на устройстве.\n\n"
                   "СОХРАНИТЬ СООБЩЕНИЕ ИЗ ЧАТА\n"
                   "Нажмите или удерживайте сообщение в чате, канале или личной переписке и выберите «Добавить в заготовки», "
                   "если этот пункт доступен в меню клиента. Текст и доступный локальный медиафайл будут сохранены. "
                   "Если Telegram ещё не загрузил медиа на устройство, сначала загрузите его или добавьте файл через галерею.\n\n"
                   "ФОРМАТИРОВАНИЕ MARKDOWN\n"
                   "*Жирный текст*\n"
                   "_Курсив_\n"
                   "__Подчёркнутый текст__\n"
                   "~Зачёркнутый текст~\n"
                   "||Спойлер||\n"
                   "`Моноширинный текст`\n"
                   "[Название ссылки](https://example.com)\n"
                   "> Цитата\n"
                   "Каждый перенос строки в редакторе сохраняется. Для списков используйте • или — в начале строки.\n\n"
                   "ПРЕМИУМ-ЭМОДЗИ TELEGRAM\n"
                   "Используйте формат <tg-emoji emoji-id='id'>символ</tg-emoji>. Вместо id укажите ID премиум-эмодзи, вместо символ — его обычный символ.\n"
                   "Полную HTML-вставку можно получить в боте @GOS_EmojiIDBot: отправьте боту премиум-эмодзи, нажмите «HTML вставки в тексте» и скопируйте полученный код в заготовку.\n"
                   "Также принимается формат <emoji id=\"ID\">символ</emoji> и ![символ](tg://emoji?id=ID). Telegram проверяет право отправки на своей стороне.\n\n"
                   "ПРИМЕЧАНИЯ\n"
                   "Заготовки и скопированные вложения хранятся локально на устройстве и не синхронизируются между устройствами. "
                   "Удаление данных приложения может удалить локальные копии медиа. Для отправки медиа Telegram может использовать своё обычное сетевое соединение.")
        dialog = AlertDialogBuilder(ctx)
        dialog.set_title("Инструкция — Workpieces Up")
        dialog.set_message(message)
        dialog.set_positive_button("Понятно", lambda builder, which: builder.dismiss())
        dialog.show()

    def find_method(self, cls, name, count):
        for method in cls.getDeclaredMethods():
            if str(method.getName()) == name and len(method.getParameterTypes()) == count:
                return method
        return None

    def hook_result_chain(self, cls):
        while cls is not None:
            name = str(cls.getName())
            if name.startswith("android.") or name.startswith("java."):
                break
            if name not in self.hooked_result_classes:
                try:
                    method = self.find_method(cls, "onActivityResult", 3)
                    if method is None:
                        self.hook_log.append("нет метода: " + name)
                    else:
                        method.setAccessible(True)
                        self.hook_method(method, ActivityResultHook(self))
                        self.hooked_result_classes.add(name)
                        self.hook_log.append("hook ok: " + name)
                except Exception as error:
                    self.hook_log.append("hook skip: %s (%s %s)" % (name, type(error).__name__, error))
            cls = cls.getSuperclass()

    def hook_field_right(self, cls):
        if self.field_right_hooked:
            return
        while cls is not None:
            name = str(cls.getName())
            if name.startswith("android.") or name.startswith("java."):
                return
            method = self.find_method(cls, "updateFieldRight", 1)
            if method is not None:
                method.setAccessible(True)
                self.hook_method(method, FieldRightHook(self))
                self.field_right_hooked = True
                return
            cls = cls.getSuperclass()

    def show_picker_report(self, title):
        text = "Запрос: %d\nХуки:\n%s\nПолучено onActivityResult с кодами: %s" % (
            PICKER_REQUEST_CODE,
            "\n".join(self.hook_log) or "нет",
            ", ".join(str(code) for code in self.seen_codes[-10:]) or "ни одного вызова",
        )
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment is not None else None
        if activity is None:
            BulletinHelper.show_error(title)
            return
        dialog = AlertDialogBuilder(activity)
        dialog.set_title(title)
        dialog.set_message(text)
        dialog.set_positive_button("OK", lambda builder, which: builder.dismiss())
        dialog.show()

    def on_app_event(self, event_type):
        if event_type != AppEvent.RESUME:
            return
        if getattr(self, "pending_picker", None) is None:
            return

        def check():
            if self.pending_picker is not None:
                self.pending_picker = None
                self.show_picker_report("Результат выбора файла не дошёл до плагина")

        run_on_ui_thread(check, 800)

    def open_file_picker(self, ctx, kind):
        try:
            activity = ctx
            if not hasattr(activity, "startActivityForResult"):
                activity = get_last_fragment().getParentActivity()
            self.seen_codes = []
            self.hook_result_chain(activity.getClass())
            intent = Intent(Intent.ACTION_OPEN_DOCUMENT)
            intent.addCategory(Intent.CATEGORY_OPENABLE)
            intent.setType(PICKER_TYPES.get(kind, "*/*"))
            intent.putExtra(Intent.EXTRA_ALLOW_MULTIPLE, True)
            self.pending_picker = {"activity": activity, "kind": kind}
            activity.startActivityForResult(intent, PICKER_REQUEST_CODE)
        except Exception as error:
            self.pending_picker = None
            self.logger.exception("cannot open file picker")
            BulletinHelper.show_error(("Не удалось открыть выбор файла: %s %s" % (type(error).__name__, error))[:160])

    def handle_picker_result(self, result_code, data):
        pending = self.pending_picker
        self.pending_picker = None
        if pending is None:
            BulletinHelper.show_error("Результат выбора пришёл, но запрос уже сброшен")
            return
        try:
            from android.app import Activity
            if int(result_code) != int(Activity.RESULT_OK):
                return
            if data is None:
                BulletinHelper.show_error("Выбор файла: пустой ответ (data=null)")
                return
            uris = []
            clip = data.getClipData()
            if clip is not None:
                for index in range(int(clip.getItemCount())):
                    uris.append(clip.getItemAt(index).getUri())
            elif data.getData() is not None:
                uris.append(data.getData())
            if not uris:
                BulletinHelper.show_error("Выбор файла: нет uri в ответе")
                return
            activity = pending["activity"]
            kind = pending["kind"]
            run_on_queue(lambda: self.process_picked(activity, uris, kind))
        except Exception as error:
            self.logger.exception("picker result handling failed")
            BulletinHelper.show_error(("Ошибка выбора файла: %s %s" % (type(error).__name__, error))[:160])

    def process_picked(self, activity, uris, kind):
        entries = []
        errors = []
        for uri in uris:
            try:
                entries.append(self.copy_picked_file(activity, uri, kind))
            except Exception as error:
                self.logger.exception("cannot copy picked file")
                errors.append(("Не удалось сохранить файл: %s %s" % (type(error).__name__, error))[:160])

        def done():
            editor = self.editor
            if editor is None:
                self.drop_files(entries)
                return
            editor["media"].extend(entries)
            editor["refresh"]()
            if errors:
                BulletinHelper.show_error(errors[0])
            elif entries:
                BulletinHelper.show_info("Прикреплено: %d" % len(entries))

        run_on_ui_thread(done)

    def entry_type(self, kind, mime):
        if kind == "photo" and mime.startswith("image/"):
            return "photo"
        if kind == "video" and mime.startswith("video/"):
            return "video"
        if kind == "audio" and mime.startswith("audio/"):
            return "audio"
        return "document"

    def media_directory(self, activity):
        directory = os.path.join(str(activity.getFilesDir().getAbsolutePath()), "workpieces_up", "media")
        os.makedirs(directory, exist_ok=True)
        return directory

    def copy_stream(self, source, output):
        buffer = jarray(jbyte)(262144)
        while True:
            count = source.read(buffer)
            if count < 0:
                break
            output.write(buffer, 0, count)

    def copy_picked_file(self, activity, uri, kind):
        destination = None
        try:
            from android.provider import OpenableColumns
            from java.io import FileOutputStream

            resolver = activity.getContentResolver()
            mime = str(resolver.getType(uri) or "application/octet-stream")

            name = str(uri.getLastPathSegment() or "file")
            try:
                cursor = resolver.query(uri, None, None, None, None)
                try:
                    if cursor is not None and cursor.moveToFirst():
                        index = cursor.getColumnIndex(OpenableColumns.DISPLAY_NAME)
                        if index >= 0:
                            name = str(cursor.getString(index) or name)
                finally:
                    if cursor is not None:
                        cursor.close()
            except Exception:
                self.logger.exception("cannot read file name")

            name = os.path.basename(name).replace("\\", "_").replace("/", "_")
            ext = os.path.splitext(name)[1]
            if not ext:
                import mimetypes
                ext = mimetypes.guess_extension(mime) or ".bin"

            destination = os.path.join(self.media_directory(activity), uuid.uuid4().hex + ext)
            source = resolver.openInputStream(uri)
            if source is None:
                raise RuntimeError("не удалось открыть файл")
            output = FileOutputStream(destination)
            try:
                self.copy_stream(source, output)
            finally:
                source.close()
                output.close()

            if os.path.getsize(destination) <= 0:
                raise RuntimeError("файл пустой")
        except Exception:
            if destination and os.path.isfile(destination):
                os.remove(destination)
            raise

        return {"path": destination, "type": self.entry_type(kind, mime), "mime": mime, "name": name}

    def find_message_file(self, message, account):
        paths = []
        try:
            found = FileLoader.getInstance(account).getPathToMessage(message.messageOwner)
            if found is not None:
                paths.append(str(found.getAbsolutePath()))
        except Exception:
            pass
        try:
            paths.append(str(message.messageOwner.attachPath or ""))
        except Exception:
            pass
        for path in paths:
            if path and os.path.isfile(path) and os.path.getsize(path) > 0:
                return path
        return ""

    def add_template_from_message(self, context):
        try:
            message = context.get("message")
            if message is None:
                BulletinHelper.show_error("Не удалось получить сообщение")
                return

            account = context.get("account")
            account = int(account) if account is not None else int(UserConfig.selectedAccount)

            text = str(message.messageOwner.message or "")
            kind = "document"
            has_media = False
            try:
                if message.isPhoto():
                    kind, has_media = "photo", True
                elif message.isVideo() or message.isGif():
                    kind, has_media = "video", True
                elif message.isDocument():
                    has_media = True
            except Exception:
                pass

            copied = ""
            name = ""
            if has_media:
                source = self.find_message_file(message, account)
                if source:
                    activity = context.get("context")
                    if activity is None or not hasattr(activity, "getFilesDir"):
                        activity = get_last_fragment().getParentActivity()
                    name = os.path.basename(source)
                    ext = os.path.splitext(source)[1] or (".mp4" if kind == "video" else ".jpg" if kind == "photo" else ".bin")
                    copied = os.path.join(self.media_directory(activity), uuid.uuid4().hex + ext)
                    shutil.copyfile(source, copied)
                else:
                    BulletinHelper.show_info("Медиа не загружено, сохранён только текст")

            if not text and not copied:
                BulletinHelper.show_error("В сообщении нет текста и загруженного файла")
                return

            media = [{"path": copied, "type": kind, "mime": "", "name": name}] if copied else []
            self.add_template(None, text, media)
            BulletinHelper.show_info("Добавлено в заготовки")
        except Exception as error:
            self.logger.exception("cannot save message as template")
            BulletinHelper.show_error(("Не удалось добавить в заготовки: %s" % error)[:160])

    def load_items(self):
        raw = self.get_setting(STORAGE_KEY, "")
        if not raw:
            return []
        try:
            data = json.loads(raw)
        except Exception:
            self.logger.exception("broken storage")
            return []
        return data if isinstance(data, list) else []

    def save_items(self):
        self.set_setting(STORAGE_KEY, json.dumps(self.items, ensure_ascii=False))

    def container(self, folder_id):
        for item in self.items:
            if item["id"] == folder_id and item["type"] == "folder":
                return item["items"]
        return self.items

    def item_media(self, item):
        if not item:
            return []
        if isinstance(item.get("media"), list):
            return item["media"]
        path = item.get("media_path")
        if path:
            return [{
                "path": path,
                "type": item.get("media_type") or "document",
                "mime": item.get("media_mime", ""),
                "name": item.get("media_name") or os.path.basename(path),
            }]
        return []

    def drop_files(self, entries):
        for entry in entries:
            try:
                path = entry.get("path", "")
                if path and os.path.isfile(path):
                    os.remove(path)
            except Exception:
                self.logger.exception("cannot delete media file")

    def row_label(self, item):
        text = item.get("text", "") or ""
        media = self.item_media(item)
        if not media:
            return text
        if not text:
            label = MEDIA_ICONS.get(media[0].get("type"), "📎") + " " + media[0].get("name", "файл")
            return label + (" (+%d)" % (len(media) - 1) if len(media) > 1 else "")
        return text + "  📎%d" % len(media)

    def add_template(self, folder_id, text, media=None):
        self.container(folder_id).append({"id": uuid.uuid4().hex[:10], "type": "template", "text": text, "media": media or []})
        self.save_items()

    def move_template_to_folder(self, item, folder):
        for index, existing in enumerate(self.items):
            if existing.get("id") == item.get("id") and existing.get("type") == "template":
                moved = self.items.pop(index)
                folder.setdefault("items", []).append(moved)
                self.save_items()
                return True
        return False

    def add_folder(self, name):
        self.items.append({"id": uuid.uuid4().hex[:10], "type": "folder", "name": name[:40], "items": []})
        self.save_items()

    def edit_template(self, item, text):
        item["text"] = text
        self.save_items()

    def rename_folder(self, item, name):
        item["name"] = name[:40]
        self.save_items()

    def delete_item(self, item_id):
        removed = None
        for i, item in enumerate(self.items):
            if item["id"] == item_id:
                removed = self.items.pop(i)
                break
            if item["type"] == "folder":
                for j, sub in enumerate(item["items"]):
                    if sub["id"] == item_id:
                        removed = item["items"].pop(j)
                        break
                if removed is not None:
                    break
        if removed is not None:
            templates = removed.get("items", []) if removed["type"] == "folder" else [removed]
            for template in templates:
                self.drop_files(self.item_media(template))
        self.save_items()

    def prepare_text(self, text):
        import re
        tg_emoji = re.compile(r"<tg-emoji\s+emoji-id\s*=\s*(['\"])(\d+)\1\s*>(.*?)</tg-emoji>", re.IGNORECASE | re.DOTALL)
        has_markdown = any(token in text for token in ("*", "_", "||", "[", ">", "~", "`"))
        if tg_emoji.search(text):
            if has_markdown:
                return tg_emoji.sub(lambda m: "![%s](tg://emoji?id=%s)" % (m.group(3), m.group(2)), text), "Markdown"
            return tg_emoji.sub(lambda m: '<emoji id="%s">%s</emoji>' % (m.group(2), m.group(3)), text), "HTML"
        return text, ("Markdown" if has_markdown else None)

    def send_template(self, item, target):
        text, mode = self.prepare_text(item.get("text", "") or "")
        self.send_content(text, mode, self.item_media(item), target)

    def parse_caption(self, text, mode):
        """Возвращает (текст, entities) или None, если разметку не удалось разобрать."""
        if not mode:
            return text, None
        if mode != "Markdown" or "tg://emoji" in text:
            return None
        from markdown_utils import parse_markdown

        parsed = parse_markdown(text)
        if isinstance(parsed, tuple):
            plain, entities = parsed[0], parsed[1]
        else:
            plain, entities = parsed.text, parsed.entities
        return str(plain), entities

    def send_album(self, group, text, mode, target, kind):
        """Отправляет группу файлов одним сообщением-альбомом. False — если не получилось."""
        from java.util import ArrayList

        caption = parse = None
        if text:
            parse = self.parse_caption(text, mode)
            if parse is None or len(parse[0]) > 1024:
                return False
            caption = parse[0]

        from java import jclass
        from org.telegram.messenger import AccountInstance

        helper = find_lottie_class(None, "org.telegram.messenger.SendMessagesHelper")
        if helper is None:
            return False
        info_class = jclass("org.telegram.messenger.SendMessagesHelper$SendingMediaInfo")

        items = ArrayList()
        for index, entry in enumerate(group):
            info = info_class()
            info.path = entry["path"]
            if entry.get("type") == "video":
                info.isVideo = True
            if index == 0 and caption:
                info.caption = caption
                if parse[1] is not None:
                    entities = parse[1]
                    if not hasattr(entities, "add"):
                        converted = ArrayList()
                        for one in entities:
                            converted.add(one)
                        entities = converted
                    info.entities = entities
            items.add(info)

        method = None
        for candidate in helper.getDeclaredMethods():
            if str(candidate.getName()) != "prepareSendingMedia":
                continue
            names = [str(t.getName()) for t in candidate.getParameterTypes()]
            if "java.util.ArrayList" in names and "org.telegram.messenger.AccountInstance" in names:
                if method is None or len(names) > len(method.getParameterTypes()):
                    method = candidate
        if method is None:
            return False

        account = AccountInstance.getInstance(int(target["account"]))
        longs = 0
        booleans = 0
        args = []
        for t in method.getParameterTypes():
            name = str(t.getName())
            if name == "org.telegram.messenger.AccountInstance":
                args.append(account)
            elif name == "java.util.ArrayList":
                args.append(items)
            elif name == "long":
                args.append(int(target["dialog_id"]) if longs == 0 else 0)
                longs += 1
            elif name == "int":
                args.append(jint(0))
            elif name == "boolean":
                # forceDocument, groupMedia, notify, остальные выключены
                args.append(True if (booleans == 0 and kind == "document") or booleans in (1, 2) else False)
                booleans += 1
            else:
                args.append(None)
        method.setAccessible(True)
        method.invoke(None, *args)
        return True

    def send_content(self, text, mode, media, target):
        options = {"account": target["account"]}
        if target["thread_id"]:
            options["replyToMsg"] = target["thread_id"]
        peer = target["dialog_id"]
        senders = {"photo": send_photo, "video": send_video, "audio": send_audio}
        try:
            if not media:
                send_text(peer, text, parse_mode=mode, **options)
                return

            valid = []
            for entry in media:
                if os.path.isfile(entry.get("path", "")):
                    valid.append(entry)
                else:
                    BulletinHelper.show_error("Файл «%s» не найден, добавьте его заново" % entry.get("name", ""))
            if not valid:
                if text:
                    send_text(peer, text, parse_mode=mode, **options)
                return

            groups = {}
            for entry in valid:
                kind = "visual" if entry.get("type") in ("photo", "video") else ("audio" if entry.get("type") == "audio" else "document")
                groups.setdefault(kind, []).append(entry)

            first = True
            for kind in ("visual", "audio", "document"):
                group = groups.get(kind)
                if not group:
                    continue
                caption = text if first else ""
                first = False
                if len(group) > 1 and not target["thread_id"]:
                    try:
                        if self.send_album(group, caption, mode, target, kind):
                            continue
                    except Exception:
                        self.logger.exception("album send failed, sending one by one")
                for index, entry in enumerate(group):
                    kwargs = dict(options)
                    kwargs["caption"] = caption if index == 0 else ""
                    if kwargs["caption"] and mode:
                        kwargs["parse_mode"] = mode
                    senders.get(entry.get("type"), send_document)(peer, entry["path"], **kwargs)
        except Exception as error:
            self.logger.exception("template send failed")
            BulletinHelper.show_error(("Не удалось отправить заготовку: %s %s" % (type(error).__name__, error))[:160])

    def find_button(self, layout):
        for i in range(layout.getChildCount()):
            child = layout.getChildAt(i)
            if child is not None and child.getTag() == BUTTON_TAG:
                return child
        return None

    def inject(self, view, attempt=0):
        if get_private_field(view, "parentFragment") is None:
            return

        layout = get_private_field(view, "attachLayout")
        if layout is None:
            if attempt < 6:
                run_on_ui_thread(lambda: self.inject(view, attempt + 1), 400)
            return

        if self.find_button(layout) is not None:
            return

        ctx = view.getContext()
        button = self.make_chat_button(ctx)
        button.setTag(BUTTON_TAG)
        background = ripple(1)
        if background is not None:
            button.setBackground(background)
        ref = WeakReference(view)
        button.setOnClickListener(OnClickListener(lambda v, ref=ref: self.on_button_click(v, ref.get())))
        layout.addView(button, 0, LinearLayout.LayoutParams(dp(48), dp(48)))
        self.fix_margin(view)

    def make_chat_button(self, ctx):
        tint = light_color(["key_chat_messagePanelIcons", "key_dialogIcon"], "#3390EC", 0.12)
        button = lottie_icon(ctx, "001", 28, "📋", tint=tint)
        if isinstance(button, TextView):
            return make_icon(ctx, BUTTON_ICONS, tint, "📋")
        try:
            button.setScaleType(ImageView.ScaleType.FIT_CENTER)
        except Exception:
            pass
        button.setPadding(dp(10), dp(10), dp(10), dp(10))
        return button

    def fix_margin(self, view):
        layout = get_private_field(view, "attachLayout")
        if layout is None or self.find_button(layout) is None:
            return
        if get_private_field(view, "editingMessageObject") is not None:
            return
        field = get_private_field(view, "messageEditText")
        if field is None:
            return
        params = field.getLayoutParams()
        if params is not None and params.rightMargin >= dp(50):
            params.rightMargin = params.rightMargin + dp(48)
            field.setLayoutParams(params)

    def current_enter_view(self):
        fragment = get_last_fragment()
        if fragment is None or str(fragment.getClass().getName()) != "org.telegram.ui.ChatActivity":
            return None
        return get_private_field(fragment, "chatActivityEnterView")

    def inject_current_chat(self):
        try:
            view = self.current_enter_view()
            if view is not None:
                self.hook_field_right(view.getClass())
                self.inject(view)
        except Exception:
            self.logger.exception("inject into open chat failed")

    def remove_from_current_chat(self):
        try:
            view = self.current_enter_view()
            layout = get_private_field(view, "attachLayout") if view is not None else None
            button = self.find_button(layout) if layout is not None else None
            if button is None:
                return
            layout.removeView(button)
            field = get_private_field(view, "messageEditText")
            params = field.getLayoutParams() if field is not None else None
            if params is not None and params.rightMargin >= dp(98):
                params.rightMargin = params.rightMargin - dp(48)
                field.setLayoutParams(params)
        except Exception:
            self.logger.exception("cleanup failed")

    def chat_fragment(self, button):
        parent = button.getParent()
        for _ in range(12):
            if parent is None:
                break
            if str(parent.getClass().getName()) == ENTER_VIEW:
                fragment = get_private_field(parent, "parentFragment")
                if fragment is not None:
                    return fragment
                break
            parent = parent.getParent()
        return get_last_fragment()

    def find_context(self, fragment, button):
        sources = [
            lambda: fragment.getParentActivity(),
            lambda: get_last_fragment().getParentActivity(),
            lambda: button.getContext(),
        ]
        for source in sources:
            try:
                ctx = source()
            except Exception:
                continue
            if ctx is not None:
                return ctx
        return None

    def on_button_click(self, button, view=None):
        step = "поиск чата"
        try:
            replay(button)
            fragment = get_private_field(view, "parentFragment") if view is not None else None
            if fragment is None:
                fragment = self.chat_fragment(button)
            if fragment is None or not hasattr(fragment, "getDialogId"):
                raise RuntimeError("чат не найден")

            step = "контекст"
            ctx = self.find_context(fragment, button)
            if ctx is None:
                raise RuntimeError("нет activity")

            step = "данные чата"
            thread_id = 0
            for name in ("getTopicId", "getThreadMessageId"):
                try:
                    value = int(getattr(fragment, name)())
                except Exception:
                    continue
                if value > 0:
                    thread_id = value
                    break

            target = {
                "dialog_id": int(fragment.getDialogId()),
                "account": int(fragment.getCurrentAccount()),
                "thread_id": thread_id,
            }

            step = "окно"
            TemplatesDialog(self, ctx, target).show()
        except Exception as error:
            self.logger.exception("cannot open templates, step: %s", step)
            BulletinHelper.show_error(("Заготовки, %s: %s %s" % (step, type(error).__name__, error))[:160])


